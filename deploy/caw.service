# systemd unit template; scripts/install.sh --systemd fills in __DIR__ and __USER__.
[Unit]
Description=Cross-Agent Workspace (shared files and memory for AI agents)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
EnvironmentFile=__DIR__/.env
ExecStart=__DIR__/.venv/bin/python -m caw
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
