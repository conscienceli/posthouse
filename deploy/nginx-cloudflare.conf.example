# nginx site for Posthouse behind Cloudflare's proxy (orange cloud).
#
# Prerequisites
#   - Posthouse listens on 127.0.0.1 only:
#       scripts/docker-start.sh --behind-proxy https://posthouse.example.com
#   - Real visitor IPs (otherwise every visitor looks like a Cloudflare address):
#       scripts/cloudflare-realip.sh | sudo tee /etc/nginx/conf.d/cloudflare-realip.conf
#   - Cloudflare settings: see docs/deploy.md#cloudflare (turn off Bot Fight Mode and Rocket Loader for
#     this hostname, keep "Always Use HTTPS" on).
#
# Pick ONE of the two server blocks below, matching Cloudflare's SSL/TLS encryption mode.

# --- Option A (recommended): SSL/TLS mode "Full (strict)" ----------------------------------------
# Traffic between Cloudflare and this server is encrypted. Create a free Origin Certificate in the
# Cloudflare dashboard (SSL/TLS > Origin Server > Create Certificate), save the two parts below,
# then switch the encryption mode to Full (strict).
server {
    listen 443 ssl http2;
    server_name posthouse.example.com;

    ssl_certificate     /etc/ssl/cloudflare/posthouse.example.com.pem;   # origin certificate
    ssl_certificate_key /etc/ssl/cloudflare/posthouse.example.com.key;   # its private key

    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;   # real visitor, restored by cloudflare-realip.conf
        proxy_set_header X-Forwarded-Proto https;         # visitors always use HTTPS at Cloudflare
        proxy_buffering off;
        proxy_read_timeout 300s;
    }
}

# --- Option B: SSL/TLS mode "Flexible" (not recommended) ------------------------------------------
# Cloudflare talks plain HTTP to this server, so passwords, tokens and file contents cross the
# internet unencrypted between Cloudflare and you. Do NOT redirect HTTP to HTTPS here: with Flexible
# mode that causes an endless redirect loop (Cloudflare already redirects visitors to HTTPS).
#
# server {
#     listen 80;
#     server_name posthouse.example.com;
#
#     client_max_body_size 20m;
#
#     location / {
#         proxy_pass http://127.0.0.1:8080;
#         proxy_http_version 1.1;
#         proxy_set_header Host $host;
#         proxy_set_header X-Forwarded-For $remote_addr;
#         proxy_set_header X-Forwarded-Proto https;
#         proxy_buffering off;
#         proxy_read_timeout 300s;
#     }
# }
