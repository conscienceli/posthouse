# Posthouse configuration.
# scripts/docker-start.sh and scripts/install.sh copy this to .env and fill in the passwords.

# --- Passwords (three levels) -------------------------------------------------
# Admin: admin web UI and everything else (delete workspaces, tokens, ...).
POSTHOUSE_ADMIN_PASSWORD=
# Agent: create workspaces and read/write files in every workspace. Empty = disabled.
POSTHOUSE_AGENT_PASSWORD=
# (Each workspace can also have its own password, set in the UI or when it is created.)

# --- Public address ----------------------------------------------------------
# The URL agents use to reach this server. Required behind a reverse proxy so OAuth
# metadata contains the right https:// address. Example: https://posthouse.example.com
POSTHOUSE_PUBLIC_URL=
# Domain for automatic HTTPS with the bundled Caddy (scripts/docker-start.sh --domain).
POSTHOUSE_DOMAIN=
# Cloudflare Tunnel token; runs cloudflared next to the app (scripts/docker-start.sh --tunnel-token).
POSTHOUSE_TUNNEL_TOKEN=

# --- Docker ------------------------------------------------------------------
# Host port and bind address for plain HTTP. With --domain the port is bound to 127.0.0.1.
POSTHOUSE_HOST_PORT=8080
POSTHOUSE_BIND=0.0.0.0
# User/group the container runs as (owner of ./data). Set by docker-start.sh.
POSTHOUSE_UID=1000
POSTHOUSE_GID=1000

# --- Bare metal (scripts/run.sh / python -m posthouse) -----------------------------
POSTHOUSE_HOST=0.0.0.0
POSTHOUSE_PORT=8080
POSTHOUSE_DATA_DIR=./data

# --- Limits and behaviour ----------------------------------------------------
POSTHOUSE_MAX_FILE_MB=10
# Version every change with git (needs git installed; the Docker image has it).
POSTHOUSE_GIT=true
# Compact each workspace's change history (git gc) every N hours; 0 turns it off.
POSTHOUSE_GIT_GC_HOURS=24
POSTHOUSE_ACCESS_TOKEN_TTL=3600
POSTHOUSE_REFRESH_TOKEN_DAYS=180
POSTHOUSE_SESSION_HOURS=12
# Failed password attempts allowed per client IP within the window.
POSTHOUSE_LOGIN_MAX_FAILURES=10
POSTHOUSE_LOGIN_WINDOW_SECONDS=600
# Reverse proxies allowed to set X-Forwarded-For / X-Forwarded-Proto (comma-separated IPs/CIDRs).
# Keep it to addresses only your proxy uses: anyone in these ranges can claim any client IP.
# docker-start.sh --domain / --behind-proxy set the Docker private ranges (the app port is then loopback-only).
POSTHOUSE_TRUSTED_PROXIES=127.0.0.1,::1
POSTHOUSE_LOG_LEVEL=info
